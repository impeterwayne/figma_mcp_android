  "scripts": {
    "build": "make -C .. build-npm",
    "pack:dry-run": "make -C .. validate-npm-pack"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/impeterwayne/figma_mcp_android.git"
  },
  "homepage": "https://github.com/impeterwayne/figma_mcp_android#readme",
