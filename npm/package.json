    "bin/darwin-amd64/",
    "bin/darwin-arm64/",
    "bin/linux-amd64/",
    "bin/linux-arm64/",
    "bin/windows-amd64/",
    "bin/windows-arm64/",
    "bin/svg2vectordrawable_runtime/"
  ],
  "keywords": [
    "figma",
    "mcp",
    "model-context-protocol",
    "ai",
    "android"
